class Solution {
    public int maxValue(int n) {
        // code here
        String s=Integer.toBinaryString(n);
        int c=0;
        StringBuilder sb=new StringBuilder();
        for(int i=0;i<s.length();i++){
            if(s.charAt(i)=='1'){
                c++;
                if(c==3){
                    sb.append('0');
                    c=0;
                }
                else{
                    sb.append('1');
                }
            }
            else{
                sb.append('0');
                c=0;
            }
        }
        return Integer.parseInt(sb.toString(),2);
        
    }
}
