class Solution {
    public String findRollOut(String s, int[] roll) {
        char[] arr = s.toCharArray();
        int[] count = new int[s.length() + 1];

        for (int x : roll) {
            count[0]++;
            count[x]--;
        }

        int active = 0;

        for (int i = 0; i < arr.length; i++) {
            active += count[i];

            arr[i] = (char) ('a' + (arr[i] - 'a' + active) % 26);
        }

        return new String(arr);
    }
}
