class Solution {
    public int longestSubseq(int[] arr) {
        // code here
        HashMap<Integer,Integer> dp=new HashMap<>();
        int maxlength=0;
        for(int i:arr){
            int left=dp.getOrDefault(i-1,0);
            int right=dp.getOrDefault(i+1,0);
            int currlength=Math.max(left,right)+1;
            dp.put(i,currlength);
            maxlength=Math.max(maxlength,currlength);
        }
        return maxlength;
    }
}
