class Solution {
    public int sameMod(int[] arr) {
        int n = arr.length;

        // Find the overall GCD of all differences relative to arr[0]
        int g = 0;
        for (int i = 1; i < n; i++) {
            g = gcd(g, Math.abs(arr[i] - arr[0]));
        }

        // If overall GCD is 0, all elements are identical -> infinite solutions
        if (g == 0) {
            return -1;
        }

        // Count the number of positive divisors of g
        int count = 0;
        for (int i = 1; i * i <= g; i++) {
            if (g % i == 0) {
                count++; // i is a divisor
                if (i * i != g) {
                    count++; // g / i is also a distinct divisor
                }
            }
        }

        return count;
    }

    private int gcd(int a, int b) {
        while (b != 0) {
            int temp = b;
            b = a % b;
            a = temp;
        }
        return a;
    }
}
